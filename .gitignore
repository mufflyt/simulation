# Machine-specific path overrides
config/paths.local.yml

# RStudio project files
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Rapp.history

# R package & compiled artifacts
*.o
*.so
*.dll
*.Rcheck/
*.tar.gz

# Data files (raw or derived — adjust as needed)
# NOTE: config/*.yml and the versioned demand-contract CSVs are force-added below
# so the canonical registry and the downstream contract can actually be committed.
*.rds
*.csv
*.tsv
*.sav
*.dta
*.xlsx
*.xls
*.feather
*.parquet
*.zip

# Images & plots
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.eps

# Intermediate model files and outputs
processed_data/
*_results.csv
*_summary.csv
*_complete.csv
*_projections*
*_bands.png
*_confidence.png

# ...but never package sources or documentation. These patterns are unanchored,
# so `*_projections*` also swallowed man/gap_projections_all_scenarios.Rd, and
# R CMD check reported that function as an undocumented code object no matter
# how many times the docs were regenerated -- the Rd could not be committed.
!R/**
!man/*.Rd
!tests/**

# Simulation folders
*/dppm_25_year_test/
*/manuscript/
*/swan_validation/
*/workforce_analysis_results*/
*/workforce*_fixed/

# System files
.DS_Store
Thumbs.db

# Microsimulation runtime artifacts (provenance sidecars + rds)
outputs/

# Force-tracked: the canonical registry and downstream contracts must be
# committable even though *.csv / *.yml sit under the ignore rules above.
!config/*.yml
!config/*.csv
!dpmm_demand_contract_v*.csv
!dpmm_demand_contract_v*_manifest.json
!tests/**/*.csv

# Back-test artifacts are deliverables and must be tracked despite the broad
# *.csv / *.png / *.parquet rules above.
!artifacts/backtest_*.csv
!artifacts/backtest_*.parquet
!artifacts/backtest_*.json

# The fitted SWAN UI coefficients, for the same reason and one more: they are
# the numbers the caveats file describes. Tracking the caveats alone records how
# a fit was made without recording what came out, and the failure that made this
# worth tracking -- visits 7-9 flipping ui.aage from -0.05 to +0.43 -- is
# invisible in the caveats and obvious in a coefficient diff. Nine terms.
# The fitted transition object stays ignored: it is a binary, so it would not
# diff, and it is reconstructible from these coefficients.
!artifacts/swan_dmdm_ui_coefficients.csv

# Frozen validation snapshots and validation diagnostics are deliverables for
# the same reason: a back-test result that cannot be re-read against the code
# that produced it is not reproducible. Total is well under a megabyte.
!artifacts/frozen_*/
!artifacts/frozen_*/*.csv
!artifacts/frozen_*/*.json
!artifacts/frozen_*/*.parquet
!artifacts/diagnostics/
!artifacts/diagnostics/*.csv
!figures/backtest_*.png
!figures/medicare_sling_workload_index.png
!figures/readme_supply_demand_trajectory.png
!figures/readme_baseline_cohort_composition.png
!figures/readme_demand_to_fte_pathway.png
!figures/meps_care_seeking_multipliers.png
!figures/meps_care_seeking_comorbidity.png

# Canonical Census NPP inputs (vetted reference data; build-ignored so the
# package build stays small -- see .Rbuildignore ^data-raw$).
!data-raw/census/
!data-raw/census/*.csv
!data-raw/calibration/
!data-raw/calibration/*.csv

# Cited obstetric reference data shipped with the package.
!inst/extdata/**/*.csv

# Real spatial-access inputs (vetted tract demand; build-ignored).
!data-raw/spatial/
!data-raw/spatial/*.csv
# Vetted workforce sensitivity datasets (carried from cliff; build-ignored).
!data-raw/sensitivity/
!data-raw/sensitivity/*.csv
# Validation mapping tables express SCIENTIFIC CHOICES (is a certified nurse
# midwife an APP? does Burch map to sling?) and carry no sensitive data, so they
# are version controlled and reviewable rather than buried in code.
!scripts/validation/mappings/
!scripts/validation/mappings/*.csv

data-raw/brfss/*.XPT
data-raw/brfss/*.xpt
# Validation run directories: evidence is local and regenerable from the
# manifest; committing generated CSVs would create a second thing to drift.
artifacts/validation/
# Archived bundles are durable local evidence, self-verifying via SHA256SUMS.
# The tarball is the object to preserve off-repo; it does not belong on main.
artifacts/validation_archive/
